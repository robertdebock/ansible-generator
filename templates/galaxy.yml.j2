---
{{ ansible_managed | comment }}

name: Release to Ansible Galaxy

on:
  release:
    types:
      - published
jobs:
  release:
    runs-on: {{ github_runner }}
    steps:
      - name: galaxy
        uses: robertdebock/galaxy-action@1.2.1
        with:
          galaxy_api_key: {% raw %}${{ secrets.galaxy_api_key }}{% endraw %}
